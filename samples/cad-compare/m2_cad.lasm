; FAS4 assembly
; Source: m2_cad.fas
; Crunch date: 8/3/26
.format compact
.nsyms 5

.symbols
  0: SYMBOL F2
  1: SYMBOL F1
  2: SYMBOL *
  3: SYMBOL Y
  4: SYMBOL +
  5: SYMBOL X
  6: SYMBOL F2
  7: SYMBOL F1
.end_symbols

.function F1, 0
  0x0000: 14 01 01 01 00    DEFUN 1, 1, 1, 0
  0x0005: 09 04 00          PUSH_G +
  0x0008: 5c 00 00          GET_LOCAL_WIDE 0
  0x000b: 18 03 00          INIT_ARGS 3
  0x000e: 03 04 00          PUSH_VALUE +
  0x0011: 32 01             PUSH_INT8 1
  0x0013: 35 02 03          USUBR 2, Y
  0x0016: 00                NIL
  0x0017: 03                PUSH_VALUE [0]
  0x0018: 19 01 00          CLEAR_ARGS 1
  0x001b: 16                END_DEFUN
.end_function

.function F2, 1
  0x001c: 14 01 01 01 00    DEFUN 1, 1, 1, 0
  0x0021: 09 02 00          PUSH_G *
  0x0024: 5c 00 00          GET_LOCAL_WIDE 0
  0x0027: 18 03 00          INIT_ARGS 3
  0x002a: 03 02 00          PUSH_VALUE *
  0x002d: 32 02             PUSH_INT8 2
  0x002f: 35 02 01          USUBR 2, [1]
  0x0032: 00                NIL
  0x0033: 03                PUSH_VALUE [0]
  0x0034: 19 01 00          CLEAR_ARGS 1
.end_function
