; FAS4 assembly
; Source: m2_cad.fas
; Crunch date: 8/3/26
.format compact
.nsyms 5

.symbols
  0: SYMBOL F2
  1: SYMBOL F1
  2: SYMBOL *
  3: SYMBOL Y
  4: SYMBOL +
  5: SYMBOL X
  6: SYMBOL F2
  7: SYMBOL F1
.end_symbols

.function F1, 0
  0x0000: DEFUN [257], 1
  0x0005: PUSH_G +
  0x0008: GET_LOCAL_WIDE 0
  0x000b: INIT_ARGS 3
  0x000e: PUSH_VALUE +
  0x0011: PUSH_INT8 1
  0x0013: USUBR 2, Y
  0x0016: NIL
  0x0017: PUSH_VALUE [0]
  0x0018: CLEAR_ARGS 1
  0x001b: END_DEFUN
.end_function

.function F2, 1
  0x001c: DEFUN [257], 1
  0x0021: PUSH_G *
  0x0024: GET_LOCAL_WIDE 0
  0x0027: INIT_ARGS 3
  0x002a: PUSH_VALUE *
  0x002d: PUSH_INT8 2
  0x002f: USUBR 2, [1]
  0x0032: NIL
  0x0033: PUSH_VALUE [0]
  0x0034: CLEAR_ARGS 1
.end_function
