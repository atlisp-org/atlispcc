; FAS4 assembly
; Source: sh_cad.fas
; Crunch date: 8/3/26
.format compact
.nsyms 5

.symbols
  0: SYMBOL F2
  1: SYMBOL F1
  2: SYMBOL *
  3: SYMBOL +
  4: SYMBOL B
  5: SYMBOL A
  6: SYMBOL F2
  7: SYMBOL F1
.end_symbols

.function F1, 0
  0x0000: DEFUN 2, 2, 2, 0
  0x0005: PUSH_G B
  0x0008: GET_LOCAL_WIDE 0
  0x000b: PUSH_G +
  0x000e: GET_LOCAL_WIDE 1
  0x0011: INIT_ARGS 5
  0x0014: PUSH_VALUE B
  0x0017: PUSH_VALUE +
  0x001a: USUBR 2, *
  0x001d: NIL
  0x001e: PUSH_VALUE [0]
  0x001f: CLEAR_ARGS 2
  0x0022: END_DEFUN
.end_function

.function F2, 1
  0x0023: DEFUN 2, 2, 2, 0
  0x0028: PUSH_G B
  0x002b: GET_LOCAL_WIDE 0
  0x002e: PUSH_G +
  0x0031: GET_LOCAL_WIDE 1
  0x0034: INIT_ARGS 5
  0x0037: PUSH_VALUE B
  0x003a: PUSH_VALUE +
  0x003d: USUBR 2, [1]
  0x0040: NIL
  0x0041: PUSH_VALUE [0]
  0x0042: CLEAR_ARGS 2
.end_function
