; FAS4 assembly
; Source: cross_cad.fas
; Crunch date: 8/3/26
.format compact
.nsyms 5

.symbols
  0: SYMBOL G
  1: SYMBOL F
  2: SYMBOL *
  3: SYMBOL Y
  4: SYMBOL G
  5: SYMBOL X
  6: SYMBOL G
  7: SYMBOL F
.end_symbols

.function F, 0
  0x0000: DEFUN 1, 1, 1, 0
  0x0005: PUSH_G [4]
  0x0008: GET_LOCAL_WIDE 0
  0x000b: INIT_ARGS 3
  0x000e: PUSH_VALUE [4]
  0x0011: USUBR 1, Y
  0x0014: NIL
  0x0015: PUSH_VALUE [0]
  0x0016: CLEAR_ARGS 1
  0x0019: END_DEFUN
.end_function

.function G, 1
  0x001a: DEFUN 1, 1, 1, 0
  0x001f: PUSH_G *
  0x0022: GET_LOCAL_WIDE 0
  0x0025: INIT_ARGS 3
  0x0028: PUSH_VALUE *
  0x002b: PUSH_VALUE *
  0x002e: USUBR 2, [1]
  0x0031: NIL
  0x0032: PUSH_VALUE [0]
  0x0033: CLEAR_ARGS 1
.end_function
