; FAS4 assembly
; Source: multi_ours.fas
; Crunch date: 8/3/26
.format compact
.nsyms 9

.symbols
  0: SYMBOL FACT
  1: SYMBOL MUL
  2: SYMBOL SUB
  3: SYMBOL ADD
  4: SYMBOL *
  5: SYMBOL FACT
  6: SYMBOL -
  7: SYMBOL <=
  8: SYMBOL N
  9: SYMBOL A
  10: SYMBOL B
  11: SYMBOL +
  12: SYMBOL FACT
  13: SYMBOL MUL
  14: SYMBOL SUB
  15: SYMBOL ADD
.end_symbols

.function ADD, 0
  0x0000: DEFUN 2, 2, 2, 0
  0x0005: PUSH_G -
  0x0008: GET_LOCAL_WIDE 0
  0x000b: PUSH_G <=
  0x000e: GET_LOCAL_WIDE 1
  0x0011: INIT_ARGS 5
  0x0014: PUSH_VALUE -
  0x0017: PUSH_VALUE <=
  0x001a: USUBR 2, +
  0x001d: NIL
  0x001e: PUSH_VALUE [2]
  0x0021: CLEAR_ARGS 2
  0x0024: END_DEFUN
.end_function

.function c:fn1, 1
  0x0025: DEFUN 2, 2, 2, 0
  0x002a: PUSH_G -
  0x002d: GET_LOCAL_WIDE 0
  0x0030: PUSH_G <=
  0x0033: GET_LOCAL_WIDE 1
  0x0036: INIT_ARGS 5
  0x0039: PUSH_VALUE -
  0x003c: PUSH_VALUE <=
  0x003f: USUBR 2, [3]
  0x0042: NIL
  0x0043: PUSH_VALUE [2]
  0x0046: CLEAR_ARGS 2
  0x0049: END_DEFUN
.end_function

.function c:fn2, 2
  0x004a: DEFUN 2, 2, 2, 0
  0x004f: PUSH_G -
  0x0052: GET_LOCAL_WIDE 0
  0x0055: PUSH_G <=
  0x0058: GET_LOCAL_WIDE 1
  0x005b: INIT_ARGS 5
  0x005e: PUSH_VALUE -
  0x0061: PUSH_VALUE <=
  0x0064: USUBR 2, [1]
  0x0067: NIL
  0x0068: PUSH_VALUE [2]
  0x006b: CLEAR_ARGS 2
  0x006e: END_DEFUN
.end_function

.function c:fn3, 3
  0x006f: DEFUN 1, 1, 1, 0
  0x0074: PUSH_G [5]
  0x0077: GET_LOCAL_WIDE 0
  0x007a: INIT_ARGS 3
  0x007d: PUSH_VALUE [5]
  0x0080: PUSH_INT8 1
  0x0082: USUBR 2, *
  0x0085: NIL
  0x0086: PUSH_VALUE [2]
  0x0089: JMP32_IFNOT 7
  0x008e: PUSH_INT8 1
  0x0090: JUMP 23
  0x0095: PUSH_VALUE [5]
  0x0098: PUSH_VALUE [5]
  0x009b: PUSH_INT8 1
  0x009d: USUBR 2, [3]
  0x00a0: NIL
  0x00a1: PUSH_VALUE [2]
  0x00a4: USUBR 1, [2]
  0x00a7: NIL
  0x00a8: PUSH_VALUE [2]
  0x00ab: USUBR 2, [1]
  0x00ae: NIL
  0x00af: PUSH_VALUE [2]
  0x00b2: CLEAR_ARGS 1
.end_function
